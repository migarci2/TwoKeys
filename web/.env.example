# Local demo: use memory, simulated Ads, fixture fallback and any access code.
LOCAL_DEMO_AUTH=true
STATE_BACKEND=memory
EXECUTOR_MODE=simulated
# Public Cloud Run demo: enables code-free role switching only while the
# executor remains simulated.
TWOKEYS_PUBLIC_DEMO=false

# Add this to run the ADK Revenue and deliberation agents plus Gemini surfaces.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Required in production (minimum 32 characters for SESSION_SECRET).
SESSION_SECRET=
FINANCE_ACCESS_CODE=
CEO_ACCESS_CODE=
AGENT_SEAM_KEY=
APP_ORIGIN=http://localhost:3000

# Cloud Run / Firestore.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)

# Real executor: Google Ads test account only.
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CAMPAIGN_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Fixture hash for EXECUTOR_MODE=simulated. Replace it with `npm run ads:snapshot`
# before using the real Google Ads test-account executor.
GOOGLE_ADS_CONFIGURATION_SNAPSHOT_HASH=sha256:fec639ba4a6879fd7a39afbf543df5fb5c1ba8353b5a7b014aad499bb0743daf
